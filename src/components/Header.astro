---
import { Icon } from "astro-icon/components";
import Logo from "./ui/Logo.astro";
import Button from "./ui/Button.astro";
import { getLangFromUrl, useTranslations, localePath, switchLangPath, langTags, type Lang } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const langLinks = [
  { code: "en", label: "EN", href: switchLangPath(Astro.url, "en") },
  { code: "pt", label: "PT", href: switchLangPath(Astro.url, "pt") },
  { code: "es", label: "ES", href: switchLangPath(Astro.url, "es") },
];

const navLinks = [
  { href: localePath(lang, "/"), label: t("nav.home") },
  { href: localePath(lang, "/about"), label: t("nav.about") },
  { href: localePath(lang, "/services"), label: t("nav.services") },
  { href: localePath(lang, "/appointment"), label: t("nav.book") },
];
---

<header
  id="site-header"
  class="h-24 flex items-center px-10 max-sm:px-6 text-accent-dark text-xl fixed top-0 left-0 right-0 bg-beige-500 z-50"
  data-top
>
  <a href={localePath(lang, "/")} class="h-12 flex-none flex items-center gap-4" aria-label="Brazilian Hair Studio">
    <Logo variant="mark" class="h-11" />
    <Logo variant="wordmark" class="h-10 max-sm:hidden" />
  </a>

  <div class="ml-auto flex items-center gap-4">
    <Button href={localePath(lang, "/appointment")} variant="dark" size="sm" class="max-sm:hidden">
      {t("nav.book")}
    </Button>

    <button
      id="menu-toggle"
      type="button"
      class="p-2"
      aria-label={t("nav.menu")}
      aria-expanded="false"
      aria-controls="nav-overlay"
    >
      <span class="relative block w-8 h-8">
        <Icon id="icon-menu" name="material-symbols-light:menu" class="w-8 h-8 absolute inset-0" aria-hidden="true" />
        <Icon id="icon-close" name="material-symbols-light:close" class="w-8 h-8 absolute inset-0" aria-hidden="true" />
      </span>
    </button>
  </div>
</header>

<!-- Full-screen nav overlay (sits behind the header) -->
<div id="nav-overlay" class="fixed inset-0 z-40 pointer-events-none overscroll-contain" inert>
  <div id="nav-bg" class="absolute inset-0 bg-beige-500"></div>

  <div class="relative h-full flex flex-col justify-center px-16 max-sm:px-10 pt-24 pb-12">
    <nav class="flex flex-col gap-2" aria-label={t("nav.label")}>
      {
        navLinks.map((link, i) => (
          <a href={link.href} class="nav-item group flex items-baseline gap-3" style={`--i: ${i}`}>
            <span class="text-accent-dark/40 font-sans text-sm w-6 text-right group-hover:text-accent-dark/70 transition-colors" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <span class="text-accent-dark font-serif italic leading-none group-hover:text-beige-700 transition-colors" style="font-size: clamp(3rem, 9vw, 4.5rem);">
              {link.label}
            </span>
          </a>
        ))
      }
    </nav>

    <div
      class="nav-item flex items-center gap-3 mt-12 pt-6 border-t border-accent-dark/20 text-sm"
      style={`--i: ${navLinks.length}`}
      aria-label={t("nav.language")}
      role="group"
    >
      {
        langLinks.map((l, i) => (
          <>
            {i > 0 && <span class="text-accent-dark/30" aria-hidden="true">|</span>}
            <a
              href={l.href}
              hreflang={langTags[l.code as Lang]}
              aria-current={lang === l.code ? "true" : undefined}
              class={
                lang === l.code
                  ? "font-semibold text-accent-dark"
                  : "text-accent-dark/60 hover:text-accent-dark transition-colors"
              }
            >
              {l.label}
            </a>
          </>
        ))
      }
    </div>
  </div>
</div>

<style>
  /* Same motion as the previous GSAP timelines, done with CSS transitions */
  #nav-bg {
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.5s cubic-bezier(0.645, 0.045, 0.355, 1) 0.15s;
  }
  .nav-item {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.25s ease-in calc((5 - var(--i)) * 40ms),
      transform 0.25s ease-in calc((5 - var(--i)) * 40ms);
  }
  #nav-overlay[data-open] #nav-bg {
    transform: scaleX(1);
    transition: transform 0.65s cubic-bezier(0.645, 0.045, 0.355, 1);
  }
  #nav-overlay[data-open] .nav-item {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.5s cubic-bezier(0.215, 0.61, 0.355, 1) calc(400ms + var(--i) * 80ms),
      transform 0.5s cubic-bezier(0.215, 0.61, 0.355, 1) calc(400ms + var(--i) * 80ms);
  }

  #icon-menu,
  #icon-close {
    transition:
      opacity 0.2s ease-in,
      transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  #icon-close {
    opacity: 0;
    transform: rotate(-45deg) scale(0.5);
  }
  #menu-toggle[aria-expanded="true"] #icon-menu {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }
  #menu-toggle[aria-expanded="true"] #icon-close {
    opacity: 1;
    transform: none;
    transition-delay: 0.1s;
  }

  #site-header {
    transition:
      transform 0.35s ease,
      background-color 0.4s ease,
      color 0.4s ease;
  }
  #site-header[data-hidden] {
    transform: translateY(-100%);
  }

  /* At the very top the bar inverts to forest, continuing the green hero below it */
  #site-header[data-top] {
    background-color: #0e3b31;
    color: #edebdf;
  }
  #site-header[data-top] :global(.btn) {
    color: #edebdf;
    border-color: #edebdf;
  }
  #site-header[data-top] :global(.btn::before) {
    background-color: #edebdf;
  }
  #site-header[data-top] :global(.btn:hover span),
  #site-header[data-top] :global(.btn:focus-visible span) {
    color: #0e3b31;
  }

  @media (prefers-reduced-motion: reduce) {
    #nav-bg,
    .nav-item,
    #icon-menu,
    #icon-close,
    #site-header {
      transition: none !important;
    }
  }
</style>

<script>
  const toggle = document.getElementById("menu-toggle")!;
  const overlay = document.getElementById("nav-overlay")!;
  const header = document.getElementById("site-header")!;

  let isOpen = false;
  let closeTimer: number | undefined;

  // Inverted (forest) bar only while at the very top and the menu is closed
  const updateTop = () => header.toggleAttribute("data-top", window.scrollY < 10 && !isOpen);

  function setOpen(next: boolean) {
    isOpen = next;
    updateTop();
    toggle.setAttribute("aria-expanded", String(next));
    document.body.style.overflow = next ? "hidden" : "";
    window.clearTimeout(closeTimer);

    if (next) {
      overlay.inert = false;
      overlay.classList.remove("pointer-events-none");
      overlay.toggleAttribute("data-open", true);
    } else {
      overlay.toggleAttribute("data-open", false);
      // Let the exit transition finish before disabling the overlay
      closeTimer = window.setTimeout(() => {
        overlay.classList.add("pointer-events-none");
        overlay.inert = true;
      }, 700);
    }
  }

  toggle.addEventListener("click", () => setOpen(!isOpen));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen) {
      setOpen(false);
      toggle.focus();
    }
  });

  // Hide header on scroll down, show on scroll up
  let lastScroll = window.scrollY;
  let ticking = false;

  window.addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const scroll = window.scrollY;
        const delta = scroll - lastScroll;
        lastScroll = scroll;
        ticking = false;
        updateTop();

        if (scroll < 80) {
          header.toggleAttribute("data-hidden", false);
        } else if (delta > 0 && !header.hasAttribute("data-hidden")) {
          if (isOpen) setOpen(false);
          header.toggleAttribute("data-hidden", true);
        } else if (delta < 0) {
          header.toggleAttribute("data-hidden", false);
        }
      });
    },
    { passive: true },
  );

  updateTop();

  // Keyboard users tabbing into the hidden header bring it back
  header.addEventListener("focusin", () => header.toggleAttribute("data-hidden", false));
</script>
