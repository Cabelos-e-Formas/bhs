---
interface Props {
  serifText?: string;
  restText?: string;
  class?: string;
  headingClass?: string;
}

const { serifText, restText, class: className, headingClass } = Astro.props;
const hasRight = Astro.slots.has("right");
---

<div
  class:list={[
    "flex max-sm:flex-col items-end max-sm:items-start justify-between gap-8 mb-16 max-sm:mb-10",
    className,
  ]}
>
  <h2
    class:list={["text-6xl font-light max-sm:text-4xl leading-[1.05]", headingClass ?? "text-accent-dark"]}
    data-reveal="mask"
  >
    {serifText && <span class="line-mask"><span class="font-serif italic">{serifText}</span></span>}
    {restText && " "}
    {restText && <span class="line-mask"><span style="--ld: 120ms">{restText}</span></span>}
  </h2>
  {
    hasRight && (
      <div data-reveal style="--d: 200ms">
        <slot name="right" />
      </div>
    )
  }
</div>
