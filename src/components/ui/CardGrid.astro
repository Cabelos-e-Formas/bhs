---
interface Props {
  cols?: "auto" | "2" | "3";
  gapBg?: string;
  bordered?: boolean;
  class?: string;
}

const {
  cols = "auto",
  gapBg = "bg-accent-dark",
  bordered = true,
  class: className,
} = Astro.props;
---

<div
  class:list={[
    "grid gap-px",
    cols === "2" && "grid-cols-2 max-sm:grid-cols-1",
    cols === "3" && "grid-cols-3 max-md:grid-cols-2",
    cols === "auto" && "grid-cols-[repeat(auto-fit,minmax(min(100%,18rem),1fr))]",
    gapBg,
    bordered && "border border-accent-dark",
    className,
  ]}
>
  <slot />
</div>
