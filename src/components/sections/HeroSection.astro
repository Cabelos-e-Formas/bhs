---
import { Image } from "astro:assets";
import heroPhoto from "../../assets/hero-balayage.jpg";
import Logo from "../ui/Logo.astro";
import Button from "../ui/Button.astro";
import { getLangFromUrl, useTranslations, localePath } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const highlightText = t("hero.highlight") ?? "";
const titleBefore = t("hero.titleBefore");
const titleText = t("hero.title");
// The subline's "·"-separated specialties become cells of the hero ledger
const specialties = (t("hero.subline") ?? "").split("·").map((s: string) => s.trim()).filter(Boolean);
---

<section id="hero-section" class="relative bg-accent-dark text-beige-300 overflow-hidden border-b-3 border-accent-dark lg:min-h-[calc(100svh-96px)] flex flex-col">
  <!-- Logo mark watermark -->
  <div class="absolute -left-40 -bottom-24 h-[70%] opacity-[0.07] pointer-events-none" aria-hidden="true">
    <Logo variant="mark" class="h-full" />
  </div>

  <!-- Headline + portrait -->
  <div class="relative flex-1 grid px-10 max-sm:px-6 pt-14 max-sm:pt-10 pb-16 max-sm:pb-0">
    <!-- Portrait: sits behind the oversized italic line -->
    <div class="hero-photo relative max-lg:order-2 max-lg:mt-10 max-lg:mx-[-2.5rem] max-sm:mx-[-1.5rem] lg:absolute lg:right-[9vw] lg:top-10 lg:bottom-16 lg:w-[27vw] max-lg:h-[26rem] max-sm:h-[22rem] overflow-hidden">
      <div class="hero-photo-inner absolute inset-0">
        <Image
          src={heroPhoto}
          alt={t("hero.photoAlt")}
          widths={[480, 800, 1086]}
          sizes="(min-width: 1024px) 27vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="w-full h-full object-cover object-[50%_30%]"
        />
      </div>
      <!-- Darkens the band where the italic line crosses, for contrast -->
      <div class="absolute inset-0 bg-linear-to-b from-transparent via-accent-dark/10 to-accent-dark/70 pointer-events-none"></div>
    </div>

    <h1 class="relative z-10 self-center font-light leading-[0.92] tracking-[-0.01em] max-lg:order-1">
      {titleBefore && (
        <span class="hero-line hero-line-a block text-[clamp(2.75rem,7.2vw,8.5rem)]">
          <span class="hero-mask"><span class="hero-rise" style="--d: 150ms">{titleBefore}</span></span>
        </span>
      )}
      <span class="hero-line hero-line-b block font-serif italic text-[clamp(3.6rem,13.2vw,15.5rem)] leading-[1] -ml-[0.04em] whitespace-nowrap">
        <span class="hero-mask"><span class="hero-rise hero-highlight" style="--d: 300ms">{highlightText}</span></span>
      </span>
      <span class="hero-line hero-line-c block text-[clamp(2.75rem,7.2vw,8.5rem)] lg:pl-[18vw]">
        <span class="hero-mask"><span class="hero-rise" style="--d: 450ms">{titleText}</span></span>
      </span>
    </h1>
  </div>

  <!-- Ledger row: specialties + booking -->
  <div class="hero-ledger relative z-10 border-t border-beige-500/20 grid grid-cols-[repeat(4,1fr)_auto] max-lg:grid-cols-2 gap-px bg-beige-500/20" style="--d: 900ms">
    {
      specialties.map((s: string) => (
        <p class="bg-accent-dark px-10 max-sm:px-6 py-7 max-sm:py-5 text-xs uppercase tracking-[0.2em] text-beige-500/75 flex items-center">
          {s}
        </p>
      ))
    }
    <div class="bg-accent-dark px-10 max-sm:px-6 py-5 flex items-center max-lg:col-span-2">
      <Button variant="light" href={localePath(lang, "/appointment")} class="whitespace-nowrap">{t("hero.cta")}</Button>
    </div>
  </div>
</section>

<style>
  /* ── Load sequence: lines rise out of their masks, portrait wipes up ── */
  .hero-mask {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.08em; /* keeps italic descenders inside the mask */
    margin-bottom: -0.08em;
  }
  .hero-rise {
    display: inline-block;
    animation: hero-rise 1.1s cubic-bezier(0.19, 1, 0.22, 1) var(--d) backwards;
  }
  @keyframes hero-rise {
    from { transform: translateY(105%); }
  }

  .hero-photo {
    animation: hero-wipe 1.4s cubic-bezier(0.77, 0, 0.175, 1) 0.1s backwards;
  }
  @keyframes hero-wipe {
    from { clip-path: inset(100% 0 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  .hero-photo-inner {
    animation: hero-zoom 2.2s cubic-bezier(0.19, 1, 0.22, 1) 0.1s backwards;
  }
  @keyframes hero-zoom {
    from { transform: scale(1.25); }
  }

  .hero-ledger {
    animation: hero-fade 0.9s ease-out var(--d) backwards;
  }
  @keyframes hero-fade {
    from { opacity: 0; }
  }

  /* Shimmer on the italic line (as before) */
  .hero-highlight {
    background: linear-gradient(90deg, #edebdf 0%, #edebdf 40%, #fff8e7 50%, #edebdf 60%, #edebdf 100%);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation:
      hero-rise 1.1s cubic-bezier(0.19, 1, 0.22, 1) var(--d) backwards,
      shimmer 4s ease-in-out 2s infinite;
  }
  @keyframes shimmer {
    0%, 100% { background-position: 100% 0; }
    50% { background-position: -100% 0; }
  }

  /* ── Scroll: the three lines drift apart, the portrait sinks (no JS) ── */
  @supports (animation-timeline: scroll()) {
    @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
      .hero-line-a,
      .hero-line-b,
      .hero-line-c,
      .hero-photo-inner {
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
        animation-fill-mode: both;
        animation-timing-function: linear;
      }
      .hero-line-a { animation-name: drift-left; }
      .hero-line-b { animation-name: drift-right; }
      .hero-line-c { animation-name: drift-left; }
      .hero-photo-inner { animation-name: sink; }
      @keyframes drift-left { to { transform: translateX(-6vw); } }
      @keyframes drift-right { to { transform: translateX(5vw); } }
      @keyframes sink { from { transform: scale(1.05); } to { transform: scale(1.05) translateY(12%); } }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-rise,
    .hero-photo,
    .hero-photo-inner,
    .hero-ledger,
    .hero-highlight {
      animation: none;
    }
  }
</style>
