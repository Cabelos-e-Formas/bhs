---
import { getLangFromUrl, useTranslations, langTags } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const fmt = new Intl.NumberFormat(langTags[lang]);

// Data-driven stats — add/remove entries freely; the grid reflows.
const stats = [
  { target: 25, suffix: "+", labelKey: "numbers.years" },
  { target: 325, suffix: "+", labelKey: "numbers.reviews" },
  { target: 1000, suffix: "+", labelKey: "numbers.clients" },
  { target: 2000, suffix: "+", labelKey: "numbers.bridal" },
];
---

<section id="numbers-section" class="border-b-3 border-accent-dark">
  <dl class="grid grid-cols-2 gap-px bg-accent-dark">
    {
      stats.map((stat, i) => (
        <div class="bg-beige-500 px-10 max-sm:px-6 pt-14 max-sm:pt-8 pb-10 max-sm:pb-6 overflow-hidden flex flex-col-reverse gap-4 max-sm:gap-2">
          <dt class="text-beige-700 text-xs uppercase tracking-widest" data-reveal style={`--d: ${(i % 2) * 120 + 120}ms`}>{t(stat.labelKey)}</dt>
          <dd class="font-serif italic text-accent-dark leading-[0.85] tracking-[-0.02em] text-[clamp(3.5rem,12vw,13rem)] tabular-nums whitespace-nowrap" data-reveal style={`--d: ${(i % 2) * 120}ms`}>
            <span data-count={stat.target}>{fmt.format(stat.target)}</span><span class="text-[0.5em] align-top">{stat.suffix}</span>
          </dd>
        </div>
      ))
    }
  </dl>
</section>
