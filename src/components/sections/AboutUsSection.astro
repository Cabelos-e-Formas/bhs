---
import { Image } from "astro:assets";
import stylistPhoto from "../../assets/stock/stylist-updo.jpg";
import PageHero from "../ui/PageHero.astro";
import ClosingBand from "../ui/ClosingBand.astro";
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations, langTags, localized } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const fmt = new Intl.NumberFormat(langTags[lang]);

const milestones = (await getCollection("history"))
  .sort((a, b) => a.data.year.localeCompare(b.data.year))
  .map(({ data }) => ({
    year: data.year,
    title: localized(data, "title", lang),
    desc: localized(data, "desc", lang),
    image: data.image,
  }));

const stats = [
  { target: 23006, label: t("aboutus.stats.clients") },
  { target: 4299, label: t("aboutus.stats.new") },
  { target: 54, label: t("aboutus.stats.professionals") },
];

const gutter = "px-10 max-sm:px-6";
---

<PageHero
  id="aboutus-hero"
  bgText="Since 1999"
  eyebrow="Brazilian Hair Studio · Est. 1999"
  heading={t("aboutus.heading")}
  subtitle={t("aboutus.subtitle")}
/>

<!-- Founding statement -->
<section class="border-b-3 border-accent-dark">
  <div class="grid lg:grid-cols-[7fr_5fr] gap-px bg-accent-dark">
    <div class={`bg-beige-500 ${gutter} py-24 max-sm:py-14 flex flex-col justify-center gap-10`}>
      <p class="font-serif italic text-accent-dark leading-snug text-[clamp(1.75rem,3vw,2.75rem)] max-w-[24ch]" data-reveal>
        {t("aboutus.pullquote")}
      </p>
      <p class="text-beige-700 leading-relaxed max-w-[36rem]" data-reveal style="--d: 150ms">
        {t("aboutus.story")}
      </p>
    </div>
    <div class="bg-beige-500 relative max-lg:h-96 max-sm:h-80 overflow-hidden" data-reveal="wipe">
      <Image
        src={stylistPhoto}
        alt={t("aboutus.photoAlt")}
        widths={[480, 800, 1100]}
        sizes="(min-width: 1024px) 42vw, 100vw"
        loading="lazy"
        class="absolute inset-0 w-full h-full object-cover"
      />
    </div>
  </div>
</section>

<!-- Timeline -->
<section id="aboutus-timeline" class="border-b-3 border-accent-dark">
  <h2 class={`${gutter} pt-24 max-sm:pt-14 pb-14 max-sm:pb-10 text-accent-dark font-light leading-[1] text-[clamp(2.5rem,7vw,7.5rem)]`} data-reveal="mask">
    <span class="line-mask"><span class="font-serif italic">{t("aboutus.timeline.serif")}</span></span>
    <span class="line-mask"><span style="--ld: 120ms">{t("aboutus.timeline.rest")}</span></span>
  </h2>

  <ol class="grid gap-px bg-accent-dark border-t border-accent-dark">
    {
      milestones.map((m) => (
        <li class="grid md:grid-cols-[4fr_8fr] gap-px bg-accent-dark">
          <div class={`bg-beige-500 ${gutter} md:pr-10 pt-12 max-sm:pt-10 md:pb-12`} data-reveal="mask">
            <p class="font-serif italic text-accent-dark leading-none text-[clamp(3.5rem,9vw,9rem)] tabular-nums"><span class="line-mask"><span>{m.year}</span></span></p>
          </div>
          <div class="bg-beige-500 px-12 max-sm:px-8 py-12 max-sm:pt-4 max-sm:pb-10 flex flex-col gap-4">
            <h3 class="text-accent-dark font-light text-3xl max-sm:text-2xl" data-reveal style="--d: 120ms">{m.title}</h3>
            <p class="text-beige-700 leading-relaxed max-w-[42rem]" data-reveal style="--d: 220ms">{m.desc}</p>
            {m.image && (
              <img src={m.image} alt={m.title} width="640" height="400" loading="lazy" decoding="async" class="mt-4 w-full max-w-xl aspect-[16/10] object-cover" />
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<!-- 2021 in numbers -->
<section id="aboutus-stats" class="border-b-3 border-accent-dark" data-reveal>
  <dl class="grid grid-cols-[3fr_3fr_3fr_3fr] max-md:grid-cols-1 gap-px bg-accent-dark">
    <div class={`bg-beige-500 ${gutter} md:pr-10 py-10 flex items-center`}>
      <p class="text-beige-700 text-xs uppercase tracking-widest leading-relaxed">{t("aboutus.stats.caption")}</p>
    </div>
    {
      stats.map((s) => (
        <div class="bg-beige-500 px-10 max-sm:px-8 py-10 flex flex-col-reverse gap-3">
          <dt class="text-beige-700 text-xs uppercase tracking-widest">{s.label}</dt>
          <dd class="font-serif italic text-accent-dark leading-none text-6xl max-sm:text-5xl tabular-nums" data-count={s.target}>
            {fmt.format(s.target)}
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<ClosingBand quote={t("servicespage.pullquote")} />
