---
import { Image } from "astro:assets";
import pillA from "../../assets/stock/sunlit-blonde.jpg";
import pillB from "../../assets/stock/curling-styling.jpg";
import { getLangFromUrl, useTranslations, localePath } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// A pill-shaped photo sits inline after the serif phrase and inside the sans phrase
const [restFirst, ...restOthers] = (t("about.heading.rest") as string).split(" ");
---

<section id="about-section" class="border-b-3 border-accent-dark px-10 max-sm:px-6 pt-28 max-sm:pt-16 pb-24 max-sm:pb-14">
  <h2 class="text-accent-dark font-light leading-[1.02] tracking-[-0.01em] text-[clamp(2.6rem,7.4vw,8.25rem)]" data-reveal>
    <span class="block">
      <span class="font-serif italic">{t("about.heading.serif")}</span>{" "}
      <span class="pill w-[2.1em]" aria-hidden="true">
        <Image src={pillA} alt="" widths={[240, 480]} sizes="18vw" loading="lazy" class="w-full h-full object-cover" />
      </span>
    </span>
    <span class="block lg:pl-[1.2em]">
      {restFirst}{" "}
      <span class="pill w-[1.6em]" aria-hidden="true">
        <Image src={pillB} alt="" widths={[200, 400]} sizes="14vw" loading="lazy" class="w-full h-full object-cover object-[50%_35%]" />
      </span>{" "}
      {restOthers.join(" ")}
    </span>
  </h2>

  <div class="mt-20 max-sm:mt-12 grid md:grid-cols-[1fr_1fr] gap-x-16 gap-y-8 border-t border-accent-dark pt-10" data-reveal style="--d: 150ms">
    <p class="text-xs uppercase tracking-widest text-beige-700" translate="no">Brazilian Hair Studio</p>
    <div class="flex flex-col gap-8 max-w-[36rem]">
      <p class="text-accent-dark text-lg font-light leading-relaxed">{t("about.body")}</p>
      <a href={localePath(lang, "/about")} class="w-fit text-accent-dark font-serif italic text-2xl underline underline-offset-[6px] decoration-1 hover:decoration-2">
        {t("about.link")}
      </a>
    </div>
  </div>
</section>

<style>
  .pill {
    display: inline-block;
    height: 0.78em;
    margin: 0 0.06em;
    vertical-align: -0.02em;
    border-radius: 999px;
    overflow: hidden;
    background: #0e3b31;
  }
</style>
