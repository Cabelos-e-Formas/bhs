---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import Logo from "../components/ui/Logo.astro";
import { useTranslations } from "../i18n/utils";
import { contact } from "../data/contact";

const t = useTranslations("en");
---

<Layout title={t("meta.notfound.title")} description={t("meta.notfound.description")} noindex>
  <section class="relative bg-accent-dark text-beige-500 border-b-3 border-accent-dark overflow-hidden min-h-[calc(100svh-6rem)] flex flex-col justify-center px-10 max-sm:px-6 py-24">
    <div class="absolute -right-32 top-1/2 -translate-y-1/2 h-[120%] opacity-[0.07] pointer-events-none" aria-hidden="true">
      <Logo variant="mark" class="h-full" />
    </div>
    <p class="relative text-xs uppercase tracking-[0.3em] text-beige-500/70 mb-8">404</p>
    <h1 class="relative font-serif italic leading-[0.95] text-[clamp(3.5rem,10vw,10rem)] max-w-[12ch]">
      {t("notfound.heading")}
    </h1>
    <p class="relative mt-8 text-lg font-light text-beige-500/80 max-w-xl">{t("notfound.body")}</p>
    <div class="relative mt-12 flex flex-wrap items-center gap-x-8 gap-y-4">
      <Button href="/" variant="light">{t("notfound.cta")}</Button>
      <a href={contact.tel} class="font-serif italic text-2xl text-beige-500/80 hover:text-beige-500 transition-colors">{contact.phone}</a>
    </div>
  </section>
</Layout>
