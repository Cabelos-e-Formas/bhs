# Long-lived Instagram API token for @brazilian.hairstudio (Instagram professional account).
# Optional — without it the Instagram section shows a "Follow us" call to action only.
INSTAGRAM_ACCESS_TOKEN=

# Google Places API (New) key — used at build time to read the salon's Google review count.
# Optional — without it the site uses GOOGLE_REVIEWS_FALLBACK from src/lib/stats.ts.
GOOGLE_PLACES_API_KEY=
# Optional — the salon's Place ID; skips the name/address lookup on each build.
GOOGLE_PLACE_ID=
